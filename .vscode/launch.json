{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "JobService (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dapr-sidecar-jobservice",
      "program": "${workspaceFolder}/services/JobService/src/JobService.Api/bin/Debug/net10.0/JobService.Api.dll",
      "args": ["--urls", "http://localhost:5000"],
      "cwd": "${workspaceFolder}",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DAPR_GRPC_PORT": "50001",
        "DAPR_HTTP_PORT": "3500",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "WorkerService (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "dapr-sidecar-worker",
      "program": "${workspaceFolder}/services/WorkerService/src/WorkerService.Api/bin/Debug/net10.0/WorkerService.Api.dll",
      "args": ["--urls", "http://localhost:5101"],
      "cwd": "${workspaceFolder}",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DAPR_GRPC_PORT": "50011",
        "DAPR_HTTP_PORT": "3501",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317"
      },
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (All Services)",
      "configurations": [
        "JobService (Debug)",
        "WorkerService (Debug)"
      ],
      "stopAll": true
    }
  ]
}
